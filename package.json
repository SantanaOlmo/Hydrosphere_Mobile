{
  "name": "hydrosphere-mobile",
  "version": "0.3.0",
  "private": true,
  "description": "Hydrosphere SoftAP console (web + Capacitor Android)",
  "scripts": {
    "sync:www": "node scripts/sync-www.js",
    "cap:sync": "npm run sync:www && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:sync": "npm run cap:sync",
    "android:open": "npm run cap:open",
    "build:apk:debug": "npm run cap:sync && cd android && .\\gradlew.bat assembleDebug",
    "build:apk:release": "npm run cap:sync && cd android && .\\gradlew.bat assembleRelease",
    "copy:apk:debug": "node scripts/copy-apk.js debug",
    "copy:apk:release": "node scripts/copy-apk.js release"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
